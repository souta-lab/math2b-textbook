---
import 'katex/dist/katex.min.css';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '読むだけで理解できる高校数学のWeb教材' } = Astro.props;
const pageTitle = title === 'ホーム' ? title : `${title} — 高校数学 読解教材`;
const base = import.meta.env.BASE_URL;
const siteOrigin = 'https://s0u7a.f5.si';
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const ogImage = `${siteOrigin}/og/math2b-textbook.png`;
const fullDescription =
  description.length >= 50
    ? description
    : `${description.replace(/。?$/, '。')}高校数学 読解教材のページです。`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={fullDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={fullDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="高校数学 読解教材" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={fullDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1f4e79" />
    <title>{pageTitle}</title>
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="icon" type="image/svg+xml" href={`${base}icons/icon.svg`} />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="高校数学 読解教材" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href={import.meta.env.BASE_URL}>高校数学 読解教材</a>
        <nav class="site-header__nav" aria-label="サイト">
          <a href={import.meta.env.BASE_URL}>目次</a>
          <a href={`${import.meta.env.BASE_URL}subjects/`}>科目一覧</a>
        </nav>
      </div>
    </header>
    <main id="main" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>読み進めるだけで理解できることを目指した、高校数学の学習教材です。</p>
    </footer>
    <script
      is:inline
      data-sw-url={`${base}sw.js`}
      data-sw-scope={base}
      data-prod={import.meta.env.PROD}
    >
      (() => {
        const tag = document.currentScript;
        if (!tag || tag.dataset.prod !== 'true') return;
        if (!('serviceWorker' in navigator)) return;
        const swUrl = tag.dataset.swUrl;
        const swScope = tag.dataset.swScope;
        if (!swUrl || !swScope) return;
        const register = () => {
          navigator.serviceWorker
            .register(new URL(swUrl, location.origin), { scope: swScope })
            .catch(() => {
              /* PWA support is progressive enhancement; ignore failures. */
            });
        };
        if (document.readyState === 'complete') register();
        else window.addEventListener('load', register, { once: true });
      })();
    </script>
    <style>
      .site-header {
        border-bottom: 1px solid var(--rule);
        background: color-mix(in srgb, var(--paper) 88%, transparent);
        backdrop-filter: saturate(1.2) blur(6px);
        position: sticky;
        top: 0;
        z-index: 20;
      }
      .site-header__inner {
        max-width: var(--measure-wide);
        margin: 0 auto;
        /* iOS notch / stand-alone safe areas (0 elsewhere). */
        padding: calc(var(--sp-3) + env(safe-area-inset-top, 0px))
          calc(var(--sp-4) + env(safe-area-inset-right, 0px)) var(--sp-3)
          calc(var(--sp-4) + env(safe-area-inset-left, 0px));
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--sp-4);
      }
      .site-brand {
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 1.02rem;
        color: var(--ink);
        text-decoration: none;
      }
      .site-header__nav {
        display: flex;
        flex-wrap: wrap;
        gap: var(--sp-4);
      }
      .site-header__nav a {
        font-size: 0.92rem;
        color: var(--ink-soft);
        text-decoration: none;
      }
      .site-main {
        max-width: var(--measure-wide);
        margin: 0 auto;
        padding: var(--sp-5) calc(var(--sp-4) + env(safe-area-inset-right, 0px))
          var(--sp-8) calc(var(--sp-4) + env(safe-area-inset-left, 0px));
      }
      .site-footer {
        border-top: 1px solid var(--rule);
        color: var(--ink-faint);
        font-size: 0.86rem;
      }
      .site-footer p {
        max-width: var(--measure-wide);
        margin: 0 auto;
        padding: var(--sp-5) calc(var(--sp-4) + env(safe-area-inset-right, 0px))
          calc(var(--sp-5) + env(safe-area-inset-bottom, 0px))
          calc(var(--sp-4) + env(safe-area-inset-left, 0px));
      }
      @media (min-width: 60rem) {
        .site-main {
          padding-top: var(--sp-6);
        }
      }
    </style>
  </body>
</html>
