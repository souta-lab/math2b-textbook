---
/**
 * Previous / next lesson links within the current unit.
 * Renders nothing when the unit has no neighbouring lesson.
 */
interface LessonLink {
  id: string;
  data: { title: string };
}

interface Props {
  prev?: LessonLink;
  next?: LessonLink;
}

const { prev, next } = Astro.props;
const hasBoth = Boolean(prev && next);
---

{
  prev || next ? (
    <nav class="lesson-nav" aria-label="レッスンの移動">
      <div class:list={['lesson-nav__grid', !hasBoth && 'lesson-nav__grid--single']}>
        {prev && (
          <a class="lesson-nav__link lesson-nav__link--prev" href={`${import.meta.env.BASE_URL}lessons/${prev.id}`} rel="prev">
            <span class="lesson-nav__dir">前のレッスン</span>
            <span class="lesson-nav__title">{prev.data.title}</span>
          </a>
        )}
        {next && (
          <a class="lesson-nav__link lesson-nav__link--next" href={`${import.meta.env.BASE_URL}lessons/${next.id}`} rel="next">
            <span class="lesson-nav__dir">次のレッスン</span>
            <span class="lesson-nav__title">{next.data.title}</span>
          </a>
        )}
      </div>
    </nav>
  ) : null
}

<style>
  .lesson-nav {
    margin-top: var(--sp-7);
  }

  .lesson-nav__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-3);
  }

  .lesson-nav__link {
    display: block;
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }

  .lesson-nav__link:hover {
    border-color: var(--rule-strong);
    background: var(--surface-soft);
  }

  .lesson-nav__dir {
    display: block;
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--ink-faint);
  }

  .lesson-nav__title {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: var(--line-tight);
  }

  @media (min-width: 60rem) {
    .lesson-nav__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .lesson-nav__grid--single {
      grid-template-columns: minmax(0, 1fr);
    }

    .lesson-nav__link--next {
      text-align: right;
    }

    .lesson-nav__grid--single .lesson-nav__link {
      text-align: left;
    }
  }
</style>
