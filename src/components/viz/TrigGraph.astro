---
import { trigGraphFrame, type TrigFn } from './viz-math';
import { trigMarkerMarkup, unitCircleInsetMarkup } from './viz-render';

interface Props {
  fn?: TrigFn;
  from?: number;
  to?: number;
  theta?: number;
  interactive?: boolean;
  linked?: boolean;
  label?: string;
}

const {
  fn = 'sin',
  from = 0,
  to = Math.PI * 2,
  theta = from,
  interactive = false,
  linked = false,
  label = `y = ${fn} θ のグラフ`,
} = Astro.props;

const frame = trigGraphFrame(fn, from, to, theta);
const marker = trigMarkerMarkup(frame);
const inset = unitCircleInsetMarkup((theta * 180) / Math.PI);
const extraCells: Array<{ key: string; label: string }> =
  fn === 'sin'
    ? [{ key: 'cos', label: 'cos θ' }]
    : fn === 'cos'
      ? [{ key: 'sin', label: 'sin θ' }]
      : [
          { key: 'sin', label: 'sin θ' },
          { key: 'cos', label: 'cos θ' },
        ];
---

<figure
  class="viz viz-graph"
  data-viz="trig-graph"
  data-fn={fn}
  data-from={String(from)}
  data-to={String(to)}
  data-interactive={interactive ? 'true' : 'false'}
>
  <svg
    class="viz-graph__svg"
    viewBox={`0 0 ${frame.width} ${frame.height}`}
    role={interactive ? 'presentation' : 'img'}
    aria-hidden={interactive ? 'true' : undefined}
    aria-label={interactive ? undefined : label}
  >
    <line
      class="v-axis"
      x1={frame.plot.x}
      y1={frame.zeroY}
      x2={frame.plot.x + frame.plot.width}
      y2={frame.zeroY}
    />
    <line
      class="v-axis"
      x1={frame.plot.x}
      y1={frame.plot.y}
      x2={frame.plot.x}
      y2={frame.plot.y + frame.plot.height}
    />
    {
      frame.asymptotes.map((a) => (
        <line
          class="v-asymptote"
          x1={a.x}
          y1={frame.plot.y}
          x2={a.x}
          y2={frame.plot.y + frame.plot.height}
        />
      ))
    }
    {
      frame.xTicks.map((tick) => (
        <>
          <line class="v-tick" x1={tick.x} y1={frame.zeroY - 3} x2={tick.x} y2={frame.zeroY + 3} />
          <text class="v-faint" x={tick.x} y={frame.zeroY + 16} text-anchor="middle">
            {tick.label}
          </text>
        </>
      ))
    }
    {
      frame.yTicks.map((tick) => (
        <>
          <line
            class="v-tick"
            x1={frame.plot.x - 3}
            y1={tick.y}
            x2={frame.plot.x + 3}
            y2={tick.y}
          />
          <text class="v-faint" x={frame.plot.x - 6} y={tick.y + 4} text-anchor="end">
            {tick.label}
          </text>
        </>
      ))
    }
    <path class="v-curve" d={frame.curve} />
    <g data-graph-dyn set:html={marker} />
  </svg>
  {
    interactive && (
      <label class="viz-graph__control">
        <span class="viz-graph__control-label">θ</span>
        <input
          type="range"
          data-graph-input
          min={String(from)}
          max={String(to)}
          step={String(Math.PI / 180)}
          value={String(theta)}
        />
      </label>
    )
  }
  {
    linked && (
      <div class="viz-graph__inset-wrap">
        <svg class="viz-graph__inset" viewBox="0 0 140 140" aria-hidden="true">
          <line class="v-axis" x1="27" y1="70" x2="113" y2="70" />
          <line class="v-axis" x1="70" y1="27" x2="70" y2="113" />
          <circle class="v-in-circle" cx="70" cy="70" r="46" />
          <g data-graph-circle set:html={inset} />
        </svg>
        <span class="viz-graph__inset-label">単位円</span>
      </div>
    )
  }
  <div class="viz-readout">
    <span>θ ＝ <span data-graph-out="theta">{frame.values.theta}</span> ＝ <span data-graph-out="thetaDeg">{frame.values.thetaDeg}</span>°</span>
    <span>{fn} θ ＝ <span data-graph-out="f">{frame.values.f}</span></span>
    {
      linked &&
        extraCells.map((cell) => (
          <span>
            {cell.label} ＝ <span data-graph-out={cell.key}>{frame.values[cell.key as 'sin' | 'cos']}</span>
          </span>
        ))
    }
  </div>
</figure>

<script>
  import { trigGraphFrame, type TrigFn } from './viz-math';
  import { trigMarkerMarkup, unitCircleInsetMarkup } from './viz-render';

  function init(root: HTMLElement): void {
    if (root.dataset.interactive !== 'true') return;
    const input = root.querySelector<HTMLInputElement>('[data-graph-input]');
    const dyn = root.querySelector<SVGGElement>('[data-graph-dyn]');
    if (!input || !dyn) return;

    const circle = root.querySelector<SVGGElement>('[data-graph-circle]');
    const fn = (root.dataset.fn ?? 'sin') as TrigFn;
    const from = Number(root.dataset.from);
    const to = Number(root.dataset.to);

    const setOut = (key: string, value: string): void => {
      const el = root.querySelector(`[data-graph-out="${key}"]`);
      if (el) el.textContent = value;
    };

    const paint = (theta: number): void => {
      const frame = trigGraphFrame(fn, from, to, theta);
      dyn.innerHTML = trigMarkerMarkup(frame);
      if (circle) circle.innerHTML = unitCircleInsetMarkup((theta * 180) / Math.PI);
      setOut('theta', frame.values.theta);
      setOut('thetaDeg', frame.values.thetaDeg);
      setOut('f', frame.values.f);
      setOut('sin', frame.values.sin);
      setOut('cos', frame.values.cos);
    };

    input.addEventListener('input', () => paint(Number(input.value)));
    paint(Number(input.value));
  }

  document.querySelectorAll<HTMLElement>('[data-viz="trig-graph"]').forEach(init);
</script>

<style is:global>
  .viz-graph {
    margin: var(--sp-5) 0;
  }
  .viz-graph__svg {
    display: block;
    width: 100%;
    max-width: 30rem;
    height: auto;
    margin-inline: auto;
  }
  .viz-graph .v-axis {
    stroke: var(--ink-faint);
    stroke-width: 1;
  }
  .viz-graph .v-tick {
    stroke: var(--ink-faint);
    stroke-width: 1;
  }
  .viz-graph .v-asymptote {
    stroke: var(--rule-strong);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  .viz-graph .v-curve {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .viz-graph .v-guide {
    stroke: var(--shu);
    stroke-width: 1.4;
    stroke-dasharray: 4 3;
  }
  .viz-graph .v-marker {
    fill: var(--shu);
    stroke: var(--surface);
    stroke-width: 2;
  }
  .viz-graph .v-faint {
    fill: var(--ink-faint);
    font-family: var(--font-body);
    font-size: 12px;
  }
  .viz-graph__control {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    max-width: 30rem;
    margin: var(--sp-2) auto 0;
  }
  .viz-graph__control-label {
    font-family: var(--font-heading);
    color: var(--ink-soft);
  }
  .viz-graph__control input[type='range'] {
    flex: 1;
    accent-color: var(--accent);
  }
  .viz-readout {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    justify-content: center;
    margin-top: var(--sp-2);
    font-size: 0.9rem;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .viz-graph__inset-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: var(--sp-3);
  }
  .viz-graph__inset {
    width: 7.5rem;
    height: auto;
  }
  .viz-graph__inset-label {
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  .viz-graph .v-in-circle {
    fill: none;
    stroke: var(--rule-strong);
    stroke-width: 1.5;
  }
  .viz-graph .v-in-radius {
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .viz-graph .v-in-point {
    fill: var(--ink);
    stroke: var(--surface);
    stroke-width: 1.5;
  }
  .viz-graph .v-in-sin {
    stroke: var(--shu);
    stroke-width: 2;
  }
  .viz-graph .v-in-cos {
    stroke: var(--correct);
    stroke-width: 2;
  }
</style>
