---
interface Props {
  deg?: number;
  label?: string;
  showValues?: boolean;
}

const { deg = 30, label, showValues = false } = Astro.props;

const vbWidth = 320;
const vbHeight = 210;
const ax = 44;
const ay = 176;
const bx = 250;
const by = 176;
const cx2 = 250;
const cy2 = ay - (bx - ax) * Math.tan((deg * Math.PI) / 180);

const midBottom = { x: (ax + bx) / 2, y: ay };
const midRight = { x: bx, y: (by + cy2) / 2 };
const midHyp = { x: (ax + cx2) / 2, y: (ay + cy2) / 2 };

const ariaLabel = label ?? `角 ${deg} 度の直角三角形。斜辺・対辺・隣辺を示す。`;
---

<figure class="viz viz-triangle" data-viz="right-triangle">
  <svg viewBox={`0 0 ${vbWidth} ${vbHeight}`} role="img" aria-label={ariaLabel}>
    <polygon class="v-tri" points={`${ax},${ay} ${bx},${by} ${cx2},${cy2}`} />
    <path class="v-right" d={`M${bx - 14} ${by} L${bx - 14} ${by - 14} L${bx} ${by - 14}`} />
    <path
      class="v-angle-arc"
      d={`M${ax + 30} ${ay} A30 30 0 0 0 ${(ax + 30 * Math.cos((deg * Math.PI) / 180)).toFixed(2)} ${(ay - 30 * Math.sin((deg * Math.PI) / 180)).toFixed(2)}`}
    />
    <text class="v-label" x={ax + 34} y={ay - 8}>θ</text>
    <text class="v-side" x={midBottom.x} y={ay + 20} text-anchor="middle">隣辺</text>
    <text class="v-side" x={bx + 10} y={midRight.y} text-anchor="start">対辺</text>
    <text class="v-side" x={midHyp.x - 6} y={midHyp.y - 8} text-anchor="end">斜辺</text>
    {
      showValues && (
        <>
          <text class="v-val" x={midBottom.x} y={ay + 36} text-anchor="middle">
            cos θ
          </text>
          <text class="v-val" x={bx + 10} y={midRight.y + 16} text-anchor="start">
            sin θ
          </text>
        </>
      )
    }
  </svg>
</figure>

<style is:global>
  .viz-triangle {
    margin: var(--sp-5) 0;
  }
  .viz-triangle svg {
    display: block;
    width: 100%;
    max-width: 20rem;
    height: auto;
    margin-inline: auto;
  }
  .viz-triangle .v-tri {
    fill: var(--surface-soft);
    stroke: var(--ink);
    stroke-width: 1.8;
    stroke-linejoin: round;
  }
  .viz-triangle .v-right {
    fill: none;
    stroke: var(--ink-faint);
    stroke-width: 1.2;
  }
  .viz-triangle .v-angle-arc {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
  }
  .viz-triangle .v-label {
    fill: var(--accent);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
  }
  .viz-triangle .v-side {
    fill: var(--ink);
    font-family: var(--font-heading);
    font-size: 13px;
  }
  .viz-triangle .v-val {
    fill: var(--ink-faint);
    font-family: var(--font-body);
    font-size: 11px;
  }
</style>
