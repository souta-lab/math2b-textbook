---
import {
  SEQUENCE_GEOM,
  sequenceFrame,
  type SequenceKind,
  type SequenceMode,
} from './sequences-math';
import { sequenceDynamicMarkup } from './sequences-render';

interface Props {
  kind?: SequenceKind;
  a?: number;
  d?: number;
  r?: number;
  maxN?: number;
  n?: number;
  mode?: SequenceMode;
  interactive?: boolean;
  label?: string;
}

const {
  kind = 'arithmetic',
  a = 2,
  d = 3,
  r = 2,
  maxN = 8,
  n = 4,
  mode = 'term',
  interactive = false,
  label,
} = Astro.props;

const params = { kind, a, d, r };
const initialN = Math.max(1, Math.min(maxN, Math.round(n)));
const frame = sequenceFrame(params, maxN, initialN, mode);
const dynamic = sequenceDynamicMarkup(frame);
const ariaLabel =
  label ??
  `${kind === 'arithmetic' ? '等差数列' : '等比数列'}の${mode === 'sum' ? '和' : '項'}のグラフ。n を動かすと第 n 項と和が読めます。`;

const { width, height } = SEQUENCE_GEOM;
const { plot, zeroY } = frame;
---

<figure
  class="viz viz-seq"
  data-viz="sequence-plot"
  data-kind={kind}
  data-a={String(a)}
  data-d={String(d)}
  data-r={String(r)}
  data-maxn={String(maxN)}
  data-mode={mode}
  data-interactive={interactive ? 'true' : 'false'}
>
  <svg
    class="viz-seq__svg"
    viewBox={`0 0 ${width} ${height}`}
    role={interactive ? 'presentation' : 'img'}
    aria-hidden={interactive ? 'true' : undefined}
    aria-label={interactive ? undefined : ariaLabel}
  >
    <line class="v-axis" x1={plot.x} y1={zeroY} x2={plot.x + plot.width} y2={zeroY} />
    <line class="v-axis" x1={plot.x} y1={plot.y} x2={plot.x} y2={plot.y + plot.height} />
    {
      frame.yTicks.map((tick) => (
        <>
          <line class="v-tick" x1={plot.x - 3} y1={tick.y} x2={plot.x + 3} y2={tick.y} />
          <text class="v-faint" x={plot.x - 6} y={tick.y + 4} text-anchor="end">
            {tick.label}
          </text>
        </>
      ))
    }
    {
      frame.xTicks.map((tick) => (
        <text class="v-faint" x={tick.x} y={zeroY + 16} text-anchor="middle">
          {tick.label}
        </text>
      ))
    }
    <text class="v-faint" x={plot.x - 6} y={plot.y - 6} text-anchor="end">
      {mode === 'sum' ? 'Sₙ' : 'aₙ'}
    </text>
    {
      frame.points.map((point) => (
        <line class="v-seq-stem" x1={point.x} y1={zeroY} x2={point.x} y2={point.y} />
      ))
    }
    <path class="v-seq-line" d={frame.polyline} />
    {
      frame.points.map((point) => (
        <circle class="v-seq-dot" cx={point.x} cy={point.y} r="3.5" />
      ))
    }
    <g data-seq-dyn set:html={dynamic} />
  </svg>
  {
    interactive && (
      <label class="viz-seq__control">
        <span class="viz-seq__control-label">n</span>
        <input
          class="viz-seq__range"
          type="range"
          data-seq-input
          min="1"
          max={String(maxN)}
          step="1"
          value={String(initialN)}
          aria-label={`n を動かす。${ariaLabel}`}
        />
        <output class="viz-seq__control-value" data-seq-out="n">
          {frame.values.n}
        </output>
      </label>
    )
  }
  <div class="viz-seq__readout">
    <span>
      第 n 項 aₙ ＝ <span data-seq-out="term">{frame.values.term}</span>
    </span>
    <span>
      初項からの和 Sₙ ＝ <span data-seq-out="sum">{frame.values.sum}</span>
    </span>
  </div>
  {interactive && <p class="viz-seq__hint">スライダーまたは ← → キーで n を動かせます。</p>}
</figure>

<script>
  import { sequenceFrame, type SequenceKind, type SequenceMode } from './sequences-math';
  import { sequenceDynamicMarkup } from './sequences-render';

  function init(root: HTMLElement): void {
    if (root.dataset.interactive !== 'true') return;
    const input = root.querySelector<HTMLInputElement>('[data-seq-input]');
    const dyn = root.querySelector<SVGGElement>('[data-seq-dyn]');
    if (!input || !dyn) return;

    const params = {
      kind: (root.dataset.kind ?? 'arithmetic') as SequenceKind,
      a: Number(root.dataset.a ?? '2'),
      d: Number(root.dataset.d ?? '3'),
      r: Number(root.dataset.r ?? '2'),
    };
    const maxN = Number(root.dataset.maxn ?? '8');
    const mode = (root.dataset.mode ?? 'term') as SequenceMode;

    const setText = (key: string, value: string): void => {
      const el = root.querySelector(`[data-seq-out="${key}"]`);
      if (el) el.textContent = value;
    };

    const paint = (rawN: number): void => {
      const frame = sequenceFrame(params, maxN, rawN, mode);
      dyn.innerHTML = sequenceDynamicMarkup(frame);
      setText('n', String(frame.values.n));
      setText('term', frame.values.term);
      setText('sum', frame.values.sum);
      input.setAttribute('aria-valuetext', frame.ariaText);
    };

    input.addEventListener('input', () => paint(Number(input.value)));
    paint(Number(input.value));
  }

  document.querySelectorAll<HTMLElement>('[data-viz="sequence-plot"]').forEach(init);
</script>

<style is:global>
  .viz-seq {
    margin: var(--sp-5) 0;
  }
  .viz-seq__svg {
    display: block;
    width: 100%;
    max-width: 30rem;
    height: auto;
    margin-inline: auto;
  }
  .viz-seq .v-axis {
    stroke: var(--ink-faint);
    stroke-width: 1;
  }
  .viz-seq .v-tick {
    stroke: var(--rule-strong);
    stroke-width: 1;
  }
  .viz-seq .v-faint {
    fill: var(--ink-faint);
    font-family: var(--font-body);
    font-size: 11px;
  }
  .viz-seq .v-seq-stem {
    stroke: var(--rule-strong);
    stroke-width: 1;
  }
  .viz-seq .v-seq-line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .viz-seq .v-seq-dot {
    fill: var(--ink);
    stroke: var(--surface);
    stroke-width: 1.5;
  }
  .viz-seq .v-seq-guide {
    stroke: var(--shu);
    stroke-width: 1.4;
    stroke-dasharray: 4 3;
  }
  .viz-seq .v-seq-halo {
    fill: none;
    stroke: var(--shu);
    stroke-width: 2;
  }
  .viz-seq .v-seq-marker {
    fill: var(--shu);
    stroke: var(--surface);
    stroke-width: 2;
  }
  .viz-seq .v-seq-marker-text {
    fill: var(--shu);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
  }
  .viz-seq__control {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    max-width: 30rem;
    margin: var(--sp-2) auto 0;
  }
  .viz-seq__control-label {
    font-family: var(--font-heading);
    color: var(--ink-soft);
  }
  .viz-seq__range {
    flex: 1;
    accent-color: var(--accent);
  }
  .viz-seq__control-value {
    min-width: 2ch;
    text-align: right;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    font-size: 0.9rem;
  }
  .viz-seq__readout {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    justify-content: center;
    margin-top: var(--sp-2);
    font-size: 0.9rem;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .viz-seq__hint {
    margin: 0.35rem 0 0;
    text-align: center;
    font-size: 0.82rem;
    color: var(--ink-faint);
  }
</style>
