---
/**
 * SelfExplanation — scaffolded self-explanation after a worked example
 * (AUTHORING.md §1.6).
 *
 * Usage:
 *   <SelfExplanation
 *     prompt="…"
 *     model="…"
 *     options={['…', '…']}
 *   />
 *
 * Shows the prompt and, optionally, candidate statements to compare against;
 * the model explanation stays behind a <details> so readers can commit to a
 * answer first. Nothing requires open-ended writing. All props are plain
 * strings (no KaTeX inside attributes).
 */
import Reveal from './Reveal.astro';

interface Props {
  prompt: string;
  model: string;
  options?: string[];
}

const { prompt, model, options } = Astro.props;
const hasOptions = options && options.length > 0;
---

<section class="self-explanation" aria-label="自己説明">
  <p class="self-explanation__label">自己説明</p>
  <p class="self-explanation__prompt">{prompt}</p>
  {
    hasOptions && (
      <>
        <p class="self-explanation__options-label">考え方の候補:</p>
        <ul class="self-explanation__options">
          {options.map((option) => (
            <li>{option}</li>
          ))}
        </ul>
      </>
    )
  }
  <Reveal label="モデルの説明を見る">
    <p>{model}</p>
  </Reveal>
</section>

<style>
  .self-explanation {
    margin: var(--sp-5) 0;
    padding: var(--sp-4);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface-soft);
  }
  .self-explanation__label {
    margin: 0 0 var(--sp-2);
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--accent);
  }
  .self-explanation__prompt {
    margin: 0 0 var(--sp-3);
    font-size: 1.04em;
  }
  .self-explanation__options-label {
    margin: 0 0 var(--sp-2);
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .self-explanation__options {
    margin: 0 0 var(--sp-2);
    padding-left: 1.6em;
  }
  .self-explanation__options li {
    margin: var(--sp-2) 0;
  }
  .self-explanation :global(details:last-child) {
    margin-bottom: 0;
  }
</style>
