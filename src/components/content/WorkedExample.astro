---
/**
 * WorkedExample — a fully solved example: problem statement, <Steps>, and a
 * final <Answer> (AUTHORING.md §1.6).
 *
 * Usage:
 *   <WorkedExample title="例題 1">
 *     問題文…
 *     <Steps>…</Steps>
 *     <Answer>…</Answer>
 *   </WorkedExample>
 *
 * `title` defaults to 「例題」. The label is visual context; document heading
 * levels remain owned by the lesson author.
 */
import { renderInlineMath, stripInlineMath } from '../../lib/inline-math';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const label = title?.trim() || '例題';
const labelText = stripInlineMath(label);
---

<section class="worked" aria-label={labelText}>
  <p class="worked__label"><Fragment set:html={renderInlineMath(label)} /></p>
  <div class="worked__body"><slot /></div>
</section>

<style>
  .worked {
    margin: var(--sp-5) 0;
    padding: var(--sp-4);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .worked__label {
    margin: 0 0 var(--sp-3);
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--accent);
  }
  .worked__body > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
