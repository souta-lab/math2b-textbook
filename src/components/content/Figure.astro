---
/**
 * Figure — a responsive frame for a visualization (AUTHORING.md §9).
 *
 * Usage:
 *   <Figure caption="単位円上の点の座標">
 *     <UnitCircle angleDeg={30} interactive showSin showCos />
 *   </Figure>
 *
 * `caption` is optional. The frame never forces horizontal overflow; long
 * display math elsewhere scrolls globally (global.css .katex-display).
 */
import { renderInlineMath } from '../../lib/inline-math';

interface Props {
  caption?: string;
}

const { caption } = Astro.props;
---

<figure class="figure">
  <div class="figure__frame"><slot /></div>
  {caption && <figcaption class="figure__caption"><Fragment set:html={renderInlineMath(caption)} /></figcaption>}
</figure>

<style>
  .figure {
    margin: var(--sp-5) 0;
    max-width: 100%;
  }
  .figure__frame {
    max-width: 100%;
  }
  .figure__frame > :global(svg),
  .figure__frame > :global(canvas),
  .figure__frame > :global(img) {
    max-width: 100%;
  }
  .figure__caption {
    margin-top: var(--sp-2);
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
</style>
