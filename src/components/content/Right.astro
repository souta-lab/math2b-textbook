---
/**
 * Right — the corrected view, inside <Misconception>.
 * Labelled 「正しい見方」 and keyed with a muted green border.
 */
---

<div class="mc mc--right">
  <p class="mc__label">正しい見方</p>
  <div class="mc__body"><slot /></div>
</div>

<style>
  .mc {
    margin: var(--sp-3) 0;
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--correct);
    border-radius: var(--radius-sm);
    background: var(--correct-soft);
  }
  .mc__label {
    margin: 0 0 var(--sp-2);
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--correct);
  }
  .mc__body > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
